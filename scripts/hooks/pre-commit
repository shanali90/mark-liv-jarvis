#!/usr/bin/env python
import subprocess
import sys
import re

PATTERNS = re.compile(r"(?i)(AIza[A-Za-z0-9_-]{35}|sk-[a-zA-Z0-9]{40}|sk-ant-[a-zA-Z0-9_-]{40}|bearer\s+[a-zA-Z0-9_\-\.]{20,}|(?:api_key|api[_-]?key|secret)\s*[:=]\s*['\"][a-zA-Z0-9_-]{30,}['\"]|\b[a-f0-9]{40}\b)")
SENSITIVE_PATHS = re.compile(
    r"(?i)(client_secret|token|api_keys\.json|\.env(?:$|\.)|"
    r"\.db$|\.sqlite3?$|voice_profile|biometric|enrollment|"
    r"audit\.jsonl|screenshots?|browser_profiles)"
)

def main():
    try:
        result = subprocess.run(["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
                                capture_output=True, text=True, encoding="utf-8", check=True)
        files = [f for f in result.stdout.splitlines() if f.strip() and "pre-commit" not in f]
    except Exception as e:
        print(f"Error getting staged files: {e}", file=sys.stderr)
        sys.exit(1)

    has_secrets = False

    for f in files:
        if SENSITIVE_PATHS.search(f):
            print(f"ERROR: Sensitive file must not be committed: {f}!", file=sys.stderr)
            has_secrets = True

    for f in files:
        try:
            diff = subprocess.run(["git", "diff", "--cached", f], capture_output=True, text=True, encoding="utf-8", check=True).stdout
        except Exception:
            continue

        for line in diff.splitlines():
            if line.startswith("+") and not line.startswith("+++"):
                if PATTERNS.search(line):
                    print(f"ERROR: Potential secret committed in {f}!", file=sys.stderr)
                    has_secrets = True
                    break

    if has_secrets:
        print("Commit blocked.", file=sys.stderr)
        sys.exit(1)

    sys.exit(0)

if __name__ == "__main__":
    main()
