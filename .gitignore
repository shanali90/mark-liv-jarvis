memory/*.db
memory/*.json
memory/*.bak
*.bak
*.db
*.sqlite
*.sqlite3
audit.jsonl
**/audit.jsonl
audit*.jsonl
browser_profiles/
**/browser_profiles/
Browser/
**/Browser/
**/User Data/
**/Firefox/Profiles/
**/Chrome/
**/Chromium/
browser-profile/
**/browser-profile/
screenshots/
**/screenshots/

